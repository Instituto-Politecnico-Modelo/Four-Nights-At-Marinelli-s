script = ExtResource("3_estado")
oculto = true

[node name="Camara" type="Marker3D" parent="Estados"]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, -1.6, 0, -8)
script = ExtResource("3_estado")

[node name="Ventana" type="Marker3D" parent="Estados"]
