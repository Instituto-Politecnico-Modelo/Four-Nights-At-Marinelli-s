[gd_resource type="Resource" script_class="PistaResource" load_steps=2 format=3]
[ext_resource type="Script" path="res://resources/pista_resource.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"formato_clave"
texto = "ARCHIVO: formato_umbral.txt\n\nLas claves UMBRAL se escriben con CUATRO cifras: primero el día, después el mes.\n\nDos cifras para cada parte, con cero delante si hace falta. Sin barras, espacios ni letras."
