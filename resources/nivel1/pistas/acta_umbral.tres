id = &"acta_umbral"
texto = "ARCHIVO: acta_umbral.txt\n\nProyecto UMBRAL. Primera apertura registrada: 14 de septiembre de 1984.\n\nPruscino subrayó la fecha y escribió al margen: «El comienzo es la clave»."
