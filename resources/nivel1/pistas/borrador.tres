[resource]
script = ExtResource("1")
id = &"borrador"
texto = "ARCHIVO: mensaje_sin_enviar.txt\n\n«Barbieri, dejé mis recordatorios repartidos entre las máquinas. Nadie va a entenderlos leyendo uno solo».\n\nEl mensaje termina ahí."
