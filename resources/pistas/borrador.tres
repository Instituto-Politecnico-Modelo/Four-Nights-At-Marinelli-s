[gd_resource type="Resource" script_class="PistaResource" load_steps=2 format=3]
[ext_resource type="Script" path="res://resources/pista_resource.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"borrador"
texto = "ARCHIVO: mensaje_sin_enviar.txt\n\n«Barbieri, dejé mis recordatorios repartidos entre las máquinas. Nadie va a entenderlos leyendo uno solo».\n\nEl mensaje termina ahí."
